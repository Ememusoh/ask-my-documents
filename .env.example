# Copy this file to .env and add real values locally.
# Never commit your real .env file.

# OpenAI is used for final grounded answer generation.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=your_openai_chat_model_here

# Pinecone is used for integrated embedding and vector storage.
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=your_pinecone_index_name_here
PINECONE_INDEX_HOST=your_pinecone_index_host_here
PINECONE_TEXT_FIELD=chunk_text
PINECONE_EMBED_MODEL=your_pinecone_embedding_model_here

# These namespaces separate the two chunking strategies for evaluation.
PINECONE_NAMESPACE_FIXED=fixed_chunks
PINECONE_NAMESPACE_PARAGRAPH=paragraph_chunks
